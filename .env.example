# Copy to .env. Never commit .env.

# Cal.diy web. On Windows use 127.0.0.1 -- Node fetch to localhost is often IPv6.
# Live URL is CAL_E2E_BASE_URL ?? CAL_BASE_URL (one origin; page objects use relative paths).
CAL_BASE_URL=http://127.0.0.1:3000

# Seed user from the cal.diy README (password = username). Fill locally.
CAL_E2E_EMAIL=pro@example.com
CAL_E2E_PASSWORD=

# DST isolated journeys (seed trial user; password equals username locally)
CAL_DST_EMAIL=trial@example.com
CAL_DST_PASSWORD=

# Used by qa-portfolio-harness getAdapter('cal') to find the local fork
PRODUCTS_ROOT=../products

# Default is prod (next build + next start). Set dev for webpack next-dev; compared trim+lowercase like the harness.
# CAL_WEB_MODE=prod

# Optional. Warmup GET /event-types/:id when CAL_WEB_MODE=dev (first compile before FW-003).
# CAL_WARMUP_EVENT_TYPE_ID=

# GitHub Actions: set this secret to enable live E2E. Empty = structural CI only.
# CAL_E2E_BASE_URL=

# 0 = skip harness health in globalSetup (CI dry mode)
# CAL_E2E=0

# Optional. Seed faker once per worker. Logged as P1_SEED=... (not a secret).
# P1_SEED=
# P1_RUN_ID=

# Optional. Playwright worker count. Default 1 (webpack serializes compiles).
# PW_WORKERS=1

# Optional. Extra console.error substrings to allow (comma-separated).
# P1_CONSOLE_ALLOWLIST=

# Documenso listen URL (127.0.0.1 only; never localhost). Default when unset: http://127.0.0.1:3001
# DOCUMENSO_BASE_URL=http://127.0.0.1:3001

# Public browser origin (non-localhost hostname; port must match listen URL). CI uses http://p1.lvh.me:3001 with hosts 127.0.0.1 p1.lvh.me
# DOCUMENSO_PUBLIC_URL=http://p1.lvh.me:3001

# Harness Documenso Postgres on 127.0.0.1:5451. Required for --project=documenso-chromium.
# DOCUMENSO_DB_URL=postgres://documenso:password@127.0.0.1:5451/documenso

# Documenso Playwright project retries (default 0). CI sets 0 to stay under login rate limits.
# P1_DOCUMENSO_RETRIES=0

# CI/local gate: harness up (no bypass) → npm run test:documenso:rate-limit → harness down/up with DANGEROUS_BYPASS_RATE_LIMITS=true → npm run test:documenso.
# Do not set DANGEROUS_BYPASS_RATE_LIMITS in .env before P1-DOC-RL-001.
